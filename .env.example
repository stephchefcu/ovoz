# Copy to .env and fill in. Everything is optional: without keys the app still runs in demo mode.

# Clinic dashboard login (change before any real use)
CLINIC_PASSWORD=demo
SESSION_SECRET=change-me-to-a-long-random-string

# Shown in the Terms & Privacy text (/privacy). PUBLIC_URL lets the bot link to that page.
CLINIC_NAME=
CLINIC_CONTACT=
PUBLIC_URL=

# Privacy rules
# Minimum number of reports before a ward / issue is shown on its own (smaller groups are rolled up)
K_MIN=3
# Staff reports are held back by a random delay up to this many hours (0 = no delay, use 0 for the demo)
STAFF_RELEASE_DELAY_HOURS=0

# VoiceLab speech-to-text (key starts with vlk_; give it Speech to text = Access). Leave empty for a demo transcript.
VOICELAB_API_KEY=
# Older Aisha API keys (not starting with vlk_) go here instead. A vlk_ key pasted here also works.
AISHA_API_KEY=

# Telegram bot (python -m app.telegram_bot). Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Any OpenAI-compatible chat API for AI triage and root-cause help. Leave empty for rule-based fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
